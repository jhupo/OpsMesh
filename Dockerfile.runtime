FROM python:3.12-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY operator ./operator
COPY runtime ./runtime
RUN uv sync --frozen --no-dev --no-editable --package opsmesh-runtime

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
COPY --from=builder /app/.venv /app/.venv
RUN addgroup --system opsmesh-runtime \
    && adduser --system --ingroup opsmesh-runtime --home /home/opsmesh-runtime opsmesh-runtime \
    && mkdir /workspace && chown opsmesh-runtime:opsmesh-runtime /workspace
USER opsmesh-runtime
WORKDIR /workspace
RUN python -m opsmesh_runtime.mcp_stdio_client --check
CMD ["sleep", "infinity"]
