FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/opsmesh-runtime

RUN addgroup --system opsmesh-runtime \
    && adduser --system --ingroup opsmesh-runtime --home /home/opsmesh-runtime opsmesh-runtime

COPY runtime/pyproject.toml ./pyproject.toml
COPY runtime/opsmesh_runtime ./opsmesh_runtime

RUN pip install --upgrade pip \
    && pip install . \
    && python -m opsmesh_runtime.mcp_stdio_client --check \
    && mkdir -p /workspace \
    && chown opsmesh-runtime:opsmesh-runtime /workspace

USER opsmesh-runtime
WORKDIR /workspace

CMD ["sleep", "infinity"]
