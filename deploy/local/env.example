OPSMESH_ENVIRONMENT=local
OPSMESH_SERVICE_NAME=opsmesh-api
OPSMESH_API_PREFIX=/api/v1
OPSMESH_LOG_LEVEL=INFO
OPSMESH_LOG_FORMAT=json
OPSMESH_ENABLE_API_DOCS=true
OPSMESH_CORS_ORIGINS=[]
OPSMESH_DATABASE_URL=postgresql+psycopg://opsmesh:opsmesh@localhost:5432/opsmesh
OPSMESH_REDIS_URL=redis://localhost:6379/0
OPSMESH_REDIS_KEY_PREFIX=opsmesh
OPSMESH_MCP_HEALTH_CHECK_STALE_AFTER_SECONDS=86400
OPSMESH_TRACING_ENABLED=true
OPSMESH_OTEL_LOGS_ENABLED=true
OPSMESH_OTEL_EXPORTER_OTLP_ENDPOINT=
OPSMESH_OTEL_EXPORTER_OTLP_INSECURE=true
OPSMESH_OTEL_EXPORTER_OTLP_HEADERS={}
OPSMESH_OTEL_TRACE_SAMPLE_RATIO=1.0
OPSMESH_OTEL_EXPORT_TIMEOUT_SECONDS=10
OPSMESH_OTEL_BATCH_MAX_QUEUE_SIZE=2048
OPSMESH_OTEL_BATCH_MAX_EXPORT_SIZE=512
OPSMESH_OTEL_BATCH_SCHEDULE_DELAY_MS=5000
OPSMESH_OTEL_EXCLUDED_URLS=/api/v1/health,/api/v1/health/live,/api/v1/health/ready,/api/v1/metrics
OPSMESH_INTERNAL_API_TOKEN=change-me-in-production
OPSMESH_TOKEN_HASH_PEPPER=change-me-token-pepper
OPSMESH_STORAGE_ROOT=.opsmesh-storage
OPSMESH_MAX_UPLOAD_BYTES=10485760
OPSMESH_EXTERNAL_CALL_MAX_ATTEMPTS=2
OPSMESH_EXTERNAL_CALL_CIRCUIT_FAILURE_THRESHOLD=5
OPSMESH_EXTERNAL_CALL_CIRCUIT_RESET_SECONDS=60
OPSMESH_API_RATE_LIMIT_ENABLED=false
OPSMESH_API_RATE_LIMIT_REQUESTS=600
OPSMESH_API_RATE_LIMIT_WINDOW_SECONDS=60
OPSMESH_AUTH_RATE_LIMIT_REQUESTS=20
OPSMESH_ADMIN_RATE_LIMIT_REQUESTS=120
OPSMESH_TRUSTED_PROXY_HOPS=0
OPSMESH_CREDENTIAL_ENCRYPTION_SECRET=change-me-credential-encryption-secret
OPSMESH_CREDENTIAL_ENCRYPTION_KEY_ID=local
OPSMESH_CREDENTIAL_ENCRYPTION_PREVIOUS_SECRETS={}
OPSMESH_RELEASE_UPDATE_ENABLED=false
OPSMESH_RELEASE_UPDATE_REPOSITORY=jhupo/OpsMesh
OPSMESH_RELEASE_UPDATE_CHECK_CACHE_SECONDS=1200
OPSMESH_RELEASE_UPDATE_GITHUB_API_URL=https://api.github.com
OPSMESH_RELEASE_UPDATE_HTTP_TIMEOUT_SECONDS=10
# OPSMESH_AUDIT_EVENT_RETENTION_DAYS=365
OPSMESH_AUDIT_INTEGRITY_CHECK_INTERVAL_SECONDS=3600
OPSMESH_AUDIT_INTEGRITY_STALE_AFTER_SECONDS=7200
OPSMESH_STORAGE_BACKEND=local
OPSMESH_S3_BUCKET=
OPSMESH_S3_ENDPOINT_URL=
OPSMESH_S3_REGION=
OPSMESH_S3_PREFIX=
OPSMESH_S3_ACCESS_KEY_ID=
OPSMESH_S3_SECRET_ACCESS_KEY=
OPSMESH_S3_SESSION_TOKEN=
OPSMESH_S3_USE_SSL=true
OPSMESH_S3_ADDRESSING_STYLE=auto
OPSMESH_RUNTIME_ALLOWED_IMAGES=[]

# Docker Compose local defaults.
OPSMESH_API_PORT=8000
OPSMESH_POSTGRES_PASSWORD=opsmesh

OPSMESH_TEMPORAL_ADDRESS=localhost:7233
OPSMESH_TEMPORAL_NAMESPACE=default
OPSMESH_TEMPORAL_TASK_QUEUE=opsmesh
OPSMESH_TEMPORAL_TLS_ENABLED=false
OPSMESH_TEMPORAL_API_KEY=
OPSMESH_TEMPORAL_WORKFLOW_CONCURRENCY=128
OPSMESH_TEMPORAL_ACTIVITY_CONCURRENCY=64
OPSMESH_TEMPORAL_BLOCKING_ACTIVITY_WORKERS=64
OPSMESH_TEMPORAL_DISPATCH_CONCURRENCY=16
OPSMESH_TEMPORAL_OUTBOX_DATABASE_POOL_SIZE=4
OPSMESH_TEMPORAL_SHUTDOWN_GRACE_SECONDS=120
OPSMESH_MODEL_REQUEST_TIMEOUT_SECONDS=600
OPSMESH_MCP_TOOL_TIMEOUT_SECONDS=30
