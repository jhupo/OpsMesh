OPSMESH_DATABASE_URL=postgresql+psycopg://opsmesh:REPLACE_PASSWORD@127.0.0.1:5432/opsmesh_host
OPSMESH_ENCRYPTION_KEY=REPLACE_WITH_BIN_OPSMESH_KEYGEN_OUTPUT
OPSMESH_DATA_DIR=/var/lib/opsmesh
OPSMESH_LOG_DIR=/var/log/opsmesh
OPSMESH_HOST=0.0.0.0
OPSMESH_PORT=8000
OPSMESH_LOG_LEVEL=INFO

# Optional initial administrator. Generated values go to a 0600 file in OPSMESH_DATA_DIR.
# The API journal prints only the file location; change the password and remove the file.
# OPSMESH_ADMIN_USERNAME=admin
# OPSMESH_ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_12_CHARACTERS

# Optional default model, configure API key and model name together.
OPSMESH_MODEL_BASE_URL=https://api.openai.com/v1
# OPSMESH_MODEL_API_KEY=
# OPSMESH_MODEL_NAME=
OPSMESH_MODEL_API_MODE=responses
OPSMESH_MODEL_REASONING_EFFORT=medium
# OPSMESH_ALLOWED_MODEL_HOSTS=["api.openai.com"]

# Omit to estimate worker capacity from CPU, memory and cgroup v2 limits.
# OPSMESH_WORKER_CONCURRENCY=8
