[Unit]
Description=OpsMesh task worker
Requires=opsmesh-migrate.service
After=opsmesh-migrate.service
PartOf=opsmesh.target

[Service]
Type=simple
User=opsmesh
Group=opsmesh
WorkingDirectory=/etc/opsmesh
ExecStart=/opt/opsmesh/current/bin/opsmesh worker tasks
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/opsmesh /var/log/opsmesh
