[Unit]
Description=OpsMesh plugin framework
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=60
User=opsmesh
Group=opsmesh
WorkingDirectory=/var/lib/opsmesh
EnvironmentFile=/etc/opsmesh/opsmesh.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/opsmesh/current/opsmesh --manifest /etc/opsmesh/host.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
StateDirectory=opsmesh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/opsmesh
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
