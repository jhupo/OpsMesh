# Compute image consumed by the official SDK DockerSandboxClient.
# It contains no OpsMesh execution daemon, queue, RPC host or network gateway.
FROM python:3.14-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /usr/local/bin/
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm git ca-certificates acl \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/images/compute-requirements.txt /tmp/compute-requirements.txt
RUN uv pip install --system --no-cache --require-hashes -r /tmp/compute-requirements.txt \
    && rm /tmp/compute-requirements.txt
ARG SANDBOX_UID=10001
ARG SANDBOX_GID=10001
RUN groupadd --gid "$SANDBOX_GID" sandbox \
    && useradd --create-home --uid "$SANDBOX_UID" --gid "$SANDBOX_GID" sandbox \
    && mkdir /workspace && chown sandbox:sandbox /workspace
USER sandbox
WORKDIR /workspace
ARG BUILD_COMMIT
LABEL org.opencontainers.image.revision=$BUILD_COMMIT
CMD ["sleep", "infinity"]
