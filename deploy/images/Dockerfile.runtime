FROM python:3.14-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md alembic.ini ./
COPY LICENSE COPYING LICENSE-MIT NOTICE ./
COPY operator ./operator
COPY runtime ./runtime
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable --package opsmesh-runtime --package opsmesh

FROM python:3.14-slim
ARG BUILD_COMMIT
LABEL org.opencontainers.image.revision=$BUILD_COMMIT
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /usr/local/bin/
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/.venv /app/.venv
RUN addgroup --system --gid 65532 opsmesh-runtime \
    && adduser --system --uid 65532 --ingroup opsmesh-runtime --home /home/opsmesh-runtime opsmesh-runtime \
    && mkdir /workspace && chown opsmesh-runtime:opsmesh-runtime /workspace
USER opsmesh-runtime
WORKDIR /workspace
RUN python -m opsmesh_runtime.mcp_stdio_client --check
CMD ["sleep", "infinity"]
