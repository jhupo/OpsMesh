{
  "input_schema": {
    "type": "object",
    "required": ["messages", "gateway"],
    "properties": {
      "messages": {"type": "array"},
      "gateway": {"type": "object"}
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": ["action", "content"],
    "properties": {
      "action": {"enum": ["reply", "ignore"]},
      "content": {"type": "array"}
    },
    "additionalProperties": false
  },
  "limits": {"timeout_seconds": 300},
  "graph": {
    "nodes": [
      {
        "key": "decision",
        "kind": "tool",
        "binding": "decision",
        "operation": "decide",
        "arguments": {
          "state": {
            "messages": {"$ref": "input.messages"},
            "gateway": {"$ref": "input.gateway"}
          }
        }
      },
      {
        "key": "answer",
        "kind": "agent",
        "input_mode": "messages",
        "binding": "assistant",
        "depends_on": ["decision"],
        "when": {
          "operator": "all",
          "conditions": [
            {"operator": "eq", "left": {"$ref": "steps.decision.output.action"}, "right": "dispatch"},
            {"operator": "eq", "left": {"$ref": "steps.decision.output.handler"}, "right": "assistant"}
          ]
        },
        "arguments": {"messages": {"$ref": "input.messages"}},
        "output_schema": {"type": "string"}
      },
      {
        "key": "reply",
        "kind": "transform",
        "depends_on": ["answer"],
        "when": {"operator": "eq", "left": {"$ref": "steps.answer.status"}, "right": "completed"},
        "value": {
          "action": "reply",
          "content": [{"type": "text", "text": {"$ref": "steps.answer.output"}}]
        }
      },
      {
        "key": "clarify",
        "kind": "transform",
        "depends_on": ["decision"],
        "when": {"operator": "eq", "left": {"$ref": "steps.decision.output.action"}, "right": "clarify"},
        "value": {
          "action": "reply",
          "content": [{"type": "text", "text": "Please clarify what you need help with."}]
        }
      }
    ],
    "output": {
      "$ref": "steps.reply.output",
      "default": {"$ref": "steps.clarify.output", "default": {"action": "ignore", "content": []}}
    }
  }
}
