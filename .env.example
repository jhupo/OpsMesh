CHAINCLOUD_ENVIRONMENT=local
CHAINCLOUD_SERVICE_NAME=chaincloud-backend
CHAINCLOUD_API_PREFIX=/api/v1
CHAINCLOUD_LOG_LEVEL=INFO
CHAINCLOUD_LOG_FORMAT=json
CHAINCLOUD_ENABLE_API_DOCS=true
CHAINCLOUD_CORS_ORIGINS=[]
CHAINCLOUD_DATABASE_URL=postgresql+psycopg://chaincloud:chaincloud@localhost:5432/chaincloud
CHAINCLOUD_REDIS_URL=redis://localhost:6379/0
CHAINCLOUD_REDIS_KEY_PREFIX=chaincloud
CHAINCLOUD_WORKER_QUEUE_NAME=agent_runs
CHAINCLOUD_INTERNAL_API_TOKEN=change-me-in-production
CHAINCLOUD_TOKEN_HASH_PEPPER=change-me-token-pepper
CHAINCLOUD_STORAGE_ROOT=.chaincloud-storage
CHAINCLOUD_MAX_UPLOAD_BYTES=10485760
CHAINCLOUD_API_RATE_LIMIT_ENABLED=false
CHAINCLOUD_API_RATE_LIMIT_REQUESTS=600
CHAINCLOUD_API_RATE_LIMIT_WINDOW_SECONDS=60
CHAINCLOUD_CREDENTIAL_ENCRYPTION_SECRET=change-me-credential-encryption-secret
CHAINCLOUD_CREDENTIAL_ENCRYPTION_KEY_ID=local
CHAINCLOUD_RUNTIME_ALLOWED_IMAGES=["python:3.12-slim"]

# Docker Compose local defaults.
CHAINCLOUD_API_PORT=8000
CHAINCLOUD_POSTGRES_PASSWORD=chaincloud
