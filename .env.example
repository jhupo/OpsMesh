# opsmesh reads process environment. Load explicitly with uv run --env-file .env ...
OPSMESH_DATA_DIRECTORY=.opsmesh
OPSMESH_HOST=127.0.0.1
OPSMESH_PORT=8000
OPSMESH_WORKER_ENABLED=true
OPSMESH_RUN_WORKER_MODE=inline
OPSMESH_TRACING_ENABLED=false
# Set enabled=true and a full OTLP HTTP trace endpoint to export asynchronously.
# OPSMESH_TRACING_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OPSMESH_TRACING_HEADERS_SECRET_REF=env:OPSMESH_OTLP_HEADERS
# OPSMESH_TRACING_TIMEOUT_SECONDS=5
# OPSMESH_TRACING_QUEUE_SIZE=2048
# OPSMESH_SKILL_GIT_ALLOWED_HOSTS=github.com
# OPSMESH_SCRIPT_EXECUTION_PROVIDER=docker
# OPSMESH_SCRIPT_EXECUTION_IMAGE=python:3.13-slim
# Trusted local execution is disabled by default.
# OPSMESH_ALLOW_TRUSTED_LOCAL=false
# PostgreSQL and Redis are optional; SQLite is the local default.
# OPSMESH_DATABASE_URL=postgresql+asyncpg://opsmesh:replace-me@127.0.0.1:5432/opsmesh
# OPSMESH_REDIS_URL=redis://127.0.0.1:6379/0
# OPSMESH_PLUGINS=my_project.plugins.assistant,my_project.plugins.tools
# OPSMESH_RUN_WORKER_ENVIRONMENT_ALLOWLIST=OPENAI_API_KEY
# OPSMESH_MEMORY_EXTRACT_MODEL_PROFILE=memory-small@1
# OPSMESH_MEMORY_CONSOLIDATE_MODEL_PROFILE=memory-large@1
# Docker Compose database password: replace before running.
OPSMESH_POSTGRES_PASSWORD=
# Optional noninteractive first administrator initialization. Never commit a filled file.
# OPSMESH_ADMIN_PASSWORD=
# Credentials are resolved only when the configured capability is invoked.
OPENAI_API_KEY=
