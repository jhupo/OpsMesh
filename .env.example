OPSMESH_DATABASE_URL=postgresql+psycopg://opsmesh:change-me@127.0.0.1:5432/opsmesh_host
OPSMESH_ENCRYPTION_KEY=REPLACE_WITH_OPSMESH_KEYGEN_OUTPUT
OPSMESH_DATA_DIR=./data
# Optional override (1-64). Omit for CPU/memory-based sizing at worker startup.
# OPSMESH_WORKER_CONCURRENCY=8
OPSMESH_LEASE_SECONDS=90
OPSMESH_LOG_LEVEL=INFO
OPSMESH_HOST=0.0.0.0
OPSMESH_PORT=8000

# Optional. Missing initial administrator values are generated on first startup.
# OPSMESH_ADMIN_USERNAME=admin
# OPSMESH_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional framework default model. Set key and model name together.
OPSMESH_MODEL_BASE_URL=https://api.openai.com/v1
# OPSMESH_MODEL_API_KEY=
# OPSMESH_MODEL_NAME=
OPSMESH_MODEL_API_MODE=responses
OPSMESH_MODEL_REASONING_EFFORT=medium
# OPSMESH_ALLOWED_MODEL_HOSTS=["api.openai.com"]

# Optional logging settings.
# OPSMESH_LOG_DIR=./data/logs
OPSMESH_LOG_CONSOLE=true
OPSMESH_LOG_FILE=true
OPSMESH_LOG_MAX_BYTES=10000000
OPSMESH_LOG_BACKUP_COUNT=5

# Separate SDK history and sandbox state are maintained for each conversation.
OPSMESH_SESSION_TTL_SECONDS=31536000
OPSMESH_SANDBOX_ROOT=/workspace
OPSMESH_FILE_LIMIT_BYTES=20000000
OPSMESH_PACKAGE_LIMIT_BYTES=20000000
